# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=spacez
POSTGRES_USER=cubixmet
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — comma-separated origins for the React app
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in magic-link emails
FRONTEND_URL=http://localhost:8080

# JWT
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# Default password assigned when an admin creates a member
DEFAULT_MEMBER_PASSWORD=spacez123

# SMTP — when HOST/USER/PASSWORD are set, real mail is sent; otherwise console backend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Space Z <hello@cubixmet.com>
